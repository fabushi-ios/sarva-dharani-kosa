{
  "name": "sarva-dharani-kosa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "梵音宝典 · Sarva-Dhāraṇī-Kośa — Pan-Buddhist Sanskrit Dhāraṇī, Siddhaṃ Phonetics & 12-Database Esoteric Literature Platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch:baseline": "node scripts/fetch-baseline-data.mjs",
    "fetch:tier1": "node scripts/fetch-tier1-databases.mjs",
    "fetch:tier23": "node scripts/fetch-tier23-databases.mjs",
    "build:corpus": "tsx scripts/build_cloud_corpus_shards.ts",
    "fetch:cited": "tsx scripts/fetch-cited-sources.ts",
    "build:citations": "tsx scripts/build-citation-check.ts",
    "deploy:staging": "bash scripts/deploy-hf-and-cf.sh --hf-only",
    "deploy:prod": "bash scripts/deploy-cf-prod.sh",
    "kosa-cli": "node scripts/kosa-cli.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "opencc-js": "^1.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
